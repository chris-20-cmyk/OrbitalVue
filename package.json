{
  "name": "orbitalvue",
  "private": true,
  "version": "5.8.0-alpha.1",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "catalog:build": "pnpm --filter @orbitalvue/catalog build",
    "catalog:test": "pnpm --filter @orbitalvue/catalog test",
    "media-centers:build": "pnpm --filter @orbitalvue/catalog build && pnpm --filter @orbitalvue/media-centers build",
    "media-centers:test": "pnpm --filter @orbitalvue/catalog build && pnpm --filter @orbitalvue/media-centers test",
    "entitlements:build": "pnpm --filter @orbitalvue/entitlement-verifier build",
    "entitlements:test": "pnpm --filter @orbitalvue/entitlement-verifier test",
    "verifier-worker:types": "pnpm --filter @orbitalvue/entitlement-verifier-worker types",
    "verifier-worker:check": "pnpm entitlements:build && pnpm --filter @orbitalvue/entitlement-verifier-worker check",
    "premium:check": "node tools/verify-premium-store-readiness.mjs",
    "verifier:check": "node tools/verify-premium-verifier-readiness.mjs",
    "privacy:check": "node tools/verify-privacy-readiness.mjs",
    "listing:check": "node tools/verify-store-listing-readiness.mjs",
    "accessibility:check": "node tools/verify-accessibility-readiness.mjs",
    "site:check": "node tools/verify-public-site-readiness.mjs",
    "site:dev": "vite --config site/vite.config.mjs",
    "site:build": "vite build --config site/vite.config.mjs",
    "release:report": "node tools/generate-release-readiness-report.mjs",
    "brand:check": "node tools/verify-orbitalvue-brand.mjs",
    "release:check": "pnpm brand:check && pnpm entitlements:build && pnpm entitlements:test && pnpm verifier-worker:check && pnpm premium:check && pnpm verifier:check && pnpm privacy:check && pnpm listing:check && pnpm accessibility:check && pnpm site:check && pnpm windows:check && pnpm apple:check && pnpm android:check && pnpm samsung:check && pnpm lg:check && node tools/verify-cross-platform-release-contract.mjs",
    "windows:check": "node tools/verify-windows-plex-account-foundation.mjs && node tools/verify-windows-media-center-progress.mjs && node tools/verify-windows-media-center-artwork.mjs",
    "apple:check": "node tools/verify-apple-brand-assets.mjs && node tools/verify-apple-distribution-readiness.mjs && node tools/verify-apple-plex-account-foundation.mjs",
    "android:check": "node tools/verify-android-plex-account-foundation.mjs",
    "samsung:check": "node tools/verify-samsung-distribution-readiness.mjs",
    "lg:check": "node tools/verify-lg-distribution-readiness.mjs",
    "tv:dev": "pnpm --filter @orbitalvue/tv-web dev",
    "tv:check": "pnpm media-centers:build && pnpm --filter @orbitalvue/tv-web check",
    "tv:test": "pnpm --filter @orbitalvue/catalog test && pnpm --filter @orbitalvue/tv-web test",
    "tv:build": "pnpm media-centers:build && pnpm --filter @orbitalvue/tv-web build"
  },
  "devDependencies": {
    "@webos-tools/cli": "3.2.5",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
