<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- IPTV providers commonly expose transport streams over HTTP. HTTPS still
         uses only the system trust store; user-installed CAs are not trusted. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
