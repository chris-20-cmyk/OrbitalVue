<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OrbitalVue" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/orbitalvue_black</item>
        <item name="android:colorAccent">@color/orbitalvue_teal</item>
        <item name="android:colorPrimary">@color/orbitalvue_teal</item>
        <item name="android:statusBarColor">@color/orbitalvue_black</item>
        <item name="android:navigationBarColor">@color/orbitalvue_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
    </style>
</resources>
