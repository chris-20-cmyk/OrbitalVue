                                <Button x:Name="UpdateActionButton" Style="{StaticResource PrimaryButton}" Click="UpdateAction_Click" Content="Check for updates" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

