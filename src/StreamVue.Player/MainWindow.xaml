                                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,9,0,0" Orientation="Horizontal">
                                                            <Button Margin="0,0,7,0" Padding="9,5" Style="{StaticResource SecondaryButton}" Click="ToggleSeriesEpisodeMode_Click" Content="{Binding EpisodeModeText}" ToolTip="Record all airings or only guide entries not marked as repeats" />
