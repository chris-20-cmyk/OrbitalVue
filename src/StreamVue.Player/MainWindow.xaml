                                                    </Style>
                                                </Button.Style>
                                                <StackPanel>
                                                    <TextBlock Foreground="#DCE5F0" FontSize="8.5" FontWeight="Bold" Text="{Binding DateText}" />
                                                    <TextBlock Margin="0,4,0,0" Foreground="#718198" FontSize="7.5" Text="{Binding SummaryText}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border CornerRadius="14" Background="#0D131D" BorderBrush="#273247" BorderThickness="1" ClipToBounds="True">
