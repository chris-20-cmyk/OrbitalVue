                                                <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="#526075" />
                                                        <TextBlock Foreground="#E3EAF4" FontSize="11.5" FontWeight="SemiBold" Text="{Binding SourceLabel}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Margin="14,5,0,0" Foreground="#718198" FontSize="9" Text="{Binding FeedName}" TextTrimming="CharacterEllipsis" />
                                                    <Border Margin="14,8,0,0" Padding="7,3" HorizontalAlignment="Left" CornerRadius="5" Background="#172432">
                                                        <TextBlock x:Name="SignalFeedStatusText" Foreground="#75B9FF" FontSize="8" FontWeight="Bold" Text="{Binding StatusText}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="16,0,20,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" Text="{Binding ScoreText}" />
                                                        <TextBlock Margin="10,0,0,0" Foreground="#B9AFFF" FontSize="10" FontWeight="SemiBold" Text="{Binding Grade}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,5,0,0" Foreground="#93A2B6" FontSize="9" Text="{Binding QualityText}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,4,0,0" Foreground="#8290A4" FontSize="9" Text="{Binding ReliabilityText}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,4,0,0" Foreground="#66758B" FontSize="8.5" Text="{Binding HistoryText}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,4,0,0" Foreground="#58677B" FontSize="8" Text="{Binding LastSeenText}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Width="230" VerticalAlignment="Center">
                                                    <Button x:Name="UseSignalFeedButton" Padding="11,7" Style="{StaticResource PrimaryButton}" Click="UseSignalFeed_Click" IsEnabled="{Binding CanUse}" Content="{Binding UseActionLabel}" />
                                                    <Grid Margin="0,7,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <Button x:Name="PreferSignalFeedButton" Margin="0,0,4,0" Padding="9,6" Style="{StaticResource SecondaryButton}" Click="PreferSignalFeed_Click" Content="{Binding PreferenceActionLabel}" />
                                                        <Button Grid.Column="1" Margin="4,0,0,0" Padding="9,6" Style="{StaticResource SecondaryButton}" Foreground="#FF9AA8" Click="BlockSignalFeed_Click" Content="{Binding BlockActionLabel}" />
                                                    </Grid>
                                                    <TextBlock Margin="0,7,0,0" HorizontalAlignment="Center" Foreground="#5F6E82" FontSize="7.8" Text="{Binding ScoreExplanation}" TextTrimming="CharacterEllipsis" />
                                                    <Button Margin="0,7,0,0" Padding="9,5" Style="{StaticResource SecondaryButton}" Click="EditSignalRouteFeed_Click" IsEnabled="{Binding CanEditRoute}" Content="{Binding RouteEditActionLabel}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="SignalFeedCard" Property="Background" Value="#102520" /><Setter TargetName="SignalFeedCard" Property="BorderBrush" Value="#34716A" /><Setter TargetName="SignalFeedStatusText" Property="Foreground" Value="{StaticResource AccentBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsPreferred}" Value="True"><Setter TargetName="SignalFeedCard" Property="BorderBrush" Value="#625376" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True"><Setter TargetName="SignalFeedCard" Property="Opacity" Value="0.58" /><Setter TargetName="PreferSignalFeedButton" Property="IsEnabled" Value="False" /></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="3" Margin="0,3,0,2" Padding="15,12" CornerRadius="12" Background="#151C28" BorderBrush="#2B374A" BorderThickness="1">
                                <TextBlock Foreground="#8291A6" FontSize="9.5" LineHeight="15" Text="Scores combine startup speed, successful tunes, buffering, reconnects, dropped frames, resolution, and bitrate. Playlist addresses and account details never appear in signal history." TextWrapping="Wrap" />
                            </Border>
                    </Grid>

                    <Border Grid.Row="2" Margin="0,18,0,0" Padding="28,16" Background="#0D131D" BorderBrush="#273247" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Foreground="#65748A" FontSize="9.5" Text="HISTORY STAYS PRIVATE ON THIS PC" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="ResetSignalHistory_Click" Content="Reset selected history" />
                                <Button Style="{StaticResource PrimaryButton}" Click="CloseSignalRouting_Click" Content="Done" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Manual XMLTV channel mapping -->
        <Grid x:Name="MappingOverlay" Grid.RowSpan="3" Panel.ZIndex="120" Background="#F4080B12" Visibility="Collapsed">
            <Border Width="980" MaxHeight="690" Margin="22" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="22" Background="#111722" BorderBrush="#344158" BorderThickness="1" ClipToBounds="True">
                <Border.Effect><DropShadowEffect BlurRadius="38" ShadowDepth="8" Opacity="0.58" Color="#000000" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <Grid Margin="28,24,28,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Guide channel mapping" />
                                <Border Margin="10,3,0,0" Padding="8,4" CornerRadius="6" Background="#17312F" VerticalAlignment="Top"><TextBlock Foreground="{StaticResource AccentBrush}" FontSize="8" FontWeight="Bold" Text="WINDOWS ENCRYPTED" /></Border>
                            </StackPanel>
                            <TextBlock x:Name="MappingStatusText" Margin="0,7,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Match playlist channels to XMLTV listings that have different names." />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}" Click="CloseMapping_Click" ToolTip="Close guide mapping"><TextBlock FontSize="18" Text="×" /></Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="24,0,24,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="355" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                        <Border CornerRadius="14" Background="#0D131D" BorderBrush="#273247" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Padding="16,12" Background="#121A26" BorderBrush="#273247" BorderThickness="0,0,0,1">
                                    <StackPanel><TextBlock Foreground="#DCE5F2" FontSize="11" FontWeight="SemiBold" Text="Playlist channels needing attention" /><TextBlock Margin="0,4,0,0" Foreground="#6E7D92" FontSize="9" Text="Temporary game feeds are excluded automatically." /></StackPanel>
                                </Border>
                                <ListBox x:Name="MappingChannelList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="MappingChannelList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="MappingChannelCard" Padding="13,11" Background="Transparent" BorderBrush="#202B3B" BorderThickness="0,0,0,1">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="8" Background="#192433"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B8C5D8" FontSize="8.5" FontWeight="Bold" Text="{Binding Initials}" /></Border><StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Foreground="#E0E7F1" FontSize="10.5" FontWeight="SemiBold" Text="{Binding ChannelName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" Foreground="#6E7D92" FontSize="8.5" Text="{Binding Status}" TextTrimming="CharacterEllipsis" /></StackPanel></Grid>
                                            </Border>
                                            <DataTemplate.Triggers><DataTrigger Binding="{Binding IsMapped}" Value="True"><Setter TargetName="MappingChannelCard" Property="Background" Value="#102520" /></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="MappingChannelCard" Property="Background" Value="#17312F" /></DataTrigger></DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" CornerRadius="14" Background="#0D131D" BorderBrush="#273247" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border Padding="17,12" Background="#121A26" BorderBrush="#273247" BorderThickness="0,0,0,1">
                                    <Grid><StackPanel><TextBlock x:Name="MappingSelectedChannelText" Foreground="#E4EBF5" FontSize="12" FontWeight="SemiBold" Text="Select a playlist channel" /><TextBlock x:Name="MappingSelectedChannelDetail" Margin="0,4,0,0" Foreground="#708096" FontSize="9" /></StackPanel><TextBlock x:Name="MappingCatalogText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" /></Grid>
                                </Border>
                                <Grid Grid.Row="1" Margin="14,12">
                                    <TextBox x:Name="MappingSearchBox" Height="38" Padding="35,8,11,8" TextChanged="MappingSearchBox_TextChanged" />
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#66758B" FontSize="16" IsHitTestVisible="False" Text="⌕" />
                                    <TextBlock x:Name="MappingSearchHint" Margin="35,0,0,0" VerticalAlignment="Center" Foreground="#56667C" FontSize="9.5" IsHitTestVisible="False" Text="Search XMLTV channel names or IDs" />
                                </Grid>
                                <ListBox x:Name="MappingCandidateList" Grid.Row="2" Margin="14,0,14,14" Background="#0A1018" BorderBrush="#243044" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="CandidateCard" Padding="13,9" Background="Transparent" BorderBrush="#1D2736" BorderThickness="0,0,0,1"><StackPanel><TextBlock Foreground="#DCE4EF" FontSize="10.5" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" Foreground="#66758B" FontSize="8.5" Text="{Binding ChannelId}" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                                            <DataTemplate.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="CandidateCard" Property="Background" Value="#17312F" /></DataTrigger><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="CandidateCard" Property="Background" Value="#15202C" /></DataTrigger></DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Margin="0,18,0,0" Padding="28,16" Background="#0D131D" BorderBrush="#273247" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Foreground="#65748A" FontSize="9.5" Text="MAPPINGS STAY ON THIS PC" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button x:Name="MappingClearButton" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="ClearMapping_Click" Content="Clear mapping" IsEnabled="False" />
                                <Button Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="CloseMapping_Click" Content="Cancel" />
                                <Button Style="{StaticResource PrimaryButton}" Click="SaveMapping_Click" Content="Save mapping" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
