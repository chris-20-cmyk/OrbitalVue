                                    <TextBlock Margin="0,0,0,7" Foreground="#AAB6C8" FontSize="10" FontWeight="SemiBold" Text="BUFFER PROFILE" />
                                    <ComboBox x:Name="BufferPresetBox" SelectionChanged="BufferPresetBox_SelectionChanged">
                                        <ComboBoxItem Content="Smart — adapts per channel" Tag="Smart" IsSelected="True" />
                                        <ComboBoxItem Content="Responsive — 1.2 sec" Tag="Responsive" />
                                        <ComboBoxItem Content="Balanced — 4 sec" Tag="Balanced" />
                                        <ComboBoxItem Content="Stable — 8 sec" Tag="Stable" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,7" Foreground="#AAB6C8" FontSize="10" FontWeight="SemiBold" Text="DEFAULT ASPECT" />
