                                </Grid>
                                <Button Margin="0,18,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="LoadFile_Click" Content="Index playlist" />
                            </StackPanel>
                        </TabItem>

                        <TabItem x:Name="UrlSourceTab" Header="M3U URL">
