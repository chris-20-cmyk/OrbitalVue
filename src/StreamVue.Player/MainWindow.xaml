                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="15,11" BorderBrush="#202B3B" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
