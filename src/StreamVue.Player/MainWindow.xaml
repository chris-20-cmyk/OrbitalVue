                            <Border Margin="0,14,0,2" Padding="15,12" CornerRadius="12" Background="#101C24" BorderBrush="#24414A" BorderThickness="1">
                                <TextBlock x:Name="UpdateProtectionNote" Foreground="#90A8AF" FontSize="10.5" LineHeight="16" Text="Every update is verified before installation. Rollback protection keeps one local last-known-good package until the new version proves it can run." TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Margin="0,18,0,0" Padding="28,16" Background="#0D131D" BorderBrush="#273247" BorderThickness="0,1,0,0">
