                                <TextBlock x:Name="DvrConflictText" HorizontalAlignment="Right" Foreground="#D4B47D" FontSize="9" FontWeight="SemiBold" Text="RIGHT-CLICK A GUIDE PROGRAM" />
                            </Grid>
                            <ItemsControl x:Name="DvrCalendarList" Margin="0,0,0,2">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
