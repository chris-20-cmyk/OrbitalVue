                                                                    <Style TargetType="ProgressBar">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers><DataTrigger Binding="{Binding ShowProgress}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                                    </Style>
                                                                </ProgressBar.Style>
                                                            </ProgressBar>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                            <Button MinWidth="66" Padding="10,6" Style="{StaticResource PrimaryButton}" Click="PlayRecording_Click" IsEnabled="{Binding CanDelete}" Content="{Binding ActionLabel}" />
                                                            <Button Margin="7,0,0,0" Padding="10,6" Style="{StaticResource SecondaryButton}" Click="OpenRecordingFileLocation_Click" Content="Show" ToolTip="Show this recording in File Explorer" />
                                                            <Button Margin="7,0,0,0" Padding="10,6" Style="{StaticResource SecondaryButton}" Foreground="#FF7184" Click="DeleteRecording_Click" IsEnabled="{Binding CanDelete}" Content="Delete" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,2" Padding="15,12" CornerRadius="12" Background="#251D13" BorderBrush="#4B3A22" BorderThickness="1">
                                <TextBlock Foreground="#D4B47D" FontSize="9.8" LineHeight="15" Text="Recording opens a separate direct stream so your picture is never interrupted. Closing the window leaves the tray recorder and wake timer armed; choose Exit StreamVue from the tray only when you want scheduled recording to stop." TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Margin="0,18,0,0" Padding="28,16" Background="#0D131D" BorderBrush="#273247" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Foreground="#65748A" FontSize="9.5" Text="CTRL + SHIFT + R  •  RECORD ACTIVE CHANNEL" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="CloseDvr_Click" Content="Close" />
