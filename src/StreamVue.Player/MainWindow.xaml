                                            <StackPanel Grid.Column="2">
                                                <TextBlock Margin="0,0,0,6" Foreground="#AAB6C8" FontSize="10" Text="LIBRARY NAME (OPTIONAL)" />
                                                <TextBox x:Name="PlexNameBox" Height="43" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Margin="0,12,0,6" Foreground="#AAB6C8" FontSize="10" Text="PLEX SERVER TOKEN" />
                                        <PasswordBox x:Name="PlexTokenBox" Height="43" Padding="12,9" Foreground="{StaticResource TextBrush}" Background="#0B1018" BorderBrush="{StaticResource BorderBrush}" />
                                        <CheckBox x:Name="PlexAllowHttpBox" Margin="0,13,0,0" Foreground="#9EACBF" FontSize="10" Content="Allow unencrypted HTTP on a trusted local network" />
                                        <Grid Margin="0,16,0,0">
                                            <TextBlock VerticalAlignment="Center" Foreground="#718198" FontSize="9.5" Text="Identity is checked before StreamVue sends the server token." />
                                            <Button x:Name="PlexConnectButton" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="LoadPlex_Click" Content="Connect Plex" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </TabItem>

                        <TabItem x:Name="EmbySourceTab" Header="Emby">
                            <StackPanel Margin="2,20,2,0">
