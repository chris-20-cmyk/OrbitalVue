                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="15,12" BorderBrush="#202B3B" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Foreground="#E0E7F1" FontSize="11" FontWeight="SemiBold" Text="{Binding ProgramTitle}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,4,0,0" Foreground="#8494AA" FontSize="9" Text="{Binding ChannelName}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,3,0,0" Foreground="#66758B" FontSize="8.5" Text="{Binding TimeText}" />
                                                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                                                <TextBlock Foreground="#57D8CC" FontSize="7.5" FontWeight="Bold" Text="{Binding PriorityText}" />
                                                                <TextBlock Margin="7,0" Foreground="#46566D" FontSize="7.5" Text="•" />
                                                                <TextBlock Foreground="#718198" FontSize="7.5" Text="{Binding SourceText}" />
                                                                <TextBlock Margin="7,0" Foreground="#46566D" FontSize="7.5" Text="•" />
                                                            <TextBlock Foreground="#718198" FontSize="7.5" Text="{Binding PaddingText}" />
                                                                <TextBlock Margin="7,0" Foreground="#46566D" FontSize="7.5" Text="•" />
                                                                <TextBlock Foreground="#718198" FontSize="7.5" Text="{Binding EpisodeText}" />
                                                                <TextBlock Margin="7,0" Foreground="#46566D" FontSize="7.5" Text="•" />
                                                                <TextBlock Foreground="#718198" FontSize="7.5" Text="{Binding EstimateText}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                            <TextBlock HorizontalAlignment="Right" Foreground="#FF7184" FontSize="8.5" FontWeight="Bold" Text="{Binding StatusText}" />
                                                            <TextBlock Margin="0,4,0,0" MaxWidth="220" Foreground="#66758B" FontSize="8" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Margin="0,0,7,0" Padding="10,6" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" Click="PrioritizeScheduledRecording_Click" IsEnabled="{Binding CanAdjustPriority}" Content="{Binding PriorityActionLabel}" />
                                                        <Button Grid.Column="3" Padding="10,6" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" Click="CancelScheduledRecording_Click" IsEnabled="{Binding CanCancel}" Content="Cancel" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Grid Margin="0,18,0,8">
                                <TextBlock Foreground="#7E8DA3" FontSize="9" FontWeight="Bold" Text="RECENT RECORDINGS" />
                                <TextBlock HorizontalAlignment="Right" Foreground="#66758B" FontSize="9" Text="MPEG-TS • ORIGINAL QUALITY" />
                            </Grid>
                            <Border CornerRadius="14" Background="#0D131D" BorderBrush="#273247" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="DvrLibraryEmptyText" Margin="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#66758B" FontSize="10.5" Text="Recordings will appear here" />
