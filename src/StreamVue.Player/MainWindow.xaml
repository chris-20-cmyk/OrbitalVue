                                        </StackPanel>
                                        <Border x:Name="UpdateStateBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,5" CornerRadius="12" Background="#17362F">
                                            <TextBlock x:Name="UpdateStateBadgeText" Foreground="{StaticResource AccentBrush}" FontSize="9.5" FontWeight="Bold" Text="READY" />
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="1" Height="1" Margin="0,18" Background="#222D3E" />

                                    <StackPanel Grid.Row="2">
                                        <TextBlock x:Name="UpdateStatusText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Ready to check for a new version" TextWrapping="Wrap" />
                                        <TextBlock x:Name="UpdateDetailText" Margin="0,7,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" LineHeight="17" Text="StreamVue checks the official public release feed. Your playlists and settings stay on this PC." TextWrapping="Wrap" />
                                        <ProgressBar x:Name="UpdateProgress" Margin="0,18,0,0" Height="5" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="UpdateOptionsPanel" Margin="0,14,0,0" Padding="17,15" CornerRadius="14" Background="#0D131D" BorderBrush="#273247" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Foreground="#AAB6C8" FontSize="10" FontWeight="SemiBold" Text="RELEASE CHANNEL" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="Stable favors finished releases. Preview includes early feature builds." />
                                        </StackPanel>
                                        <ComboBox x:Name="UpdateChannelBox" Width="132" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="UpdateChannel_SelectionChanged">
                                            <ComboBoxItem Content="Stable" Tag="Stable" />
                                            <ComboBoxItem Content="Preview" Tag="Preview" IsSelected="True" />
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Margin="0,14" Background="#222D3E" />
                                    <CheckBox x:Name="UpdateRollbackCheck" IsChecked="True" Foreground="{StaticResource TextBrush}" Checked="UpdateRollback_Changed" Unchecked="UpdateRollback_Changed">
                                        <StackPanel Margin="9,0,0,0">
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="Restore the last working version automatically" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" LineHeight="15" Text="If a new build cannot open successfully, StreamVue rolls back without touching playlists or settings." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
