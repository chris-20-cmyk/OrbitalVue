                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Automatic live-stream recovery" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Retry a dropped live channel up to three times with a short backoff." TextWrapping="Wrap" />
