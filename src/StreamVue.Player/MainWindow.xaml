                                    </CheckBox>
                                    <Border Height="1" Margin="0,14" Background="#222D3E" />
                                    <CheckBox x:Name="StallWatchdogCheck" Foreground="{StaticResource TextBrush}" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged">
