                                                        <StackPanel>
                                                            <TextBlock Foreground="#E0E7F1" FontSize="10.5" FontWeight="SemiBold" Text="{Binding ProgramTitle}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,4,0,0" Foreground="#8494AA" FontSize="8.5" Text="{Binding ChannelName}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                                            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="8.5" FontWeight="Bold" Text="{Binding PriorityText}" />
