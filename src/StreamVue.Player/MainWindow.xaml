                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Smart signal routing and feed history -->
        <Grid x:Name="SignalRoutingOverlay" Grid.RowSpan="3" Panel.ZIndex="124" Background="#F4080B12" Visibility="Collapsed">
            <Border Width="1010" MaxHeight="780" Margin="22" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="22" Background="#111722" BorderBrush="#344158" BorderThickness="1" ClipToBounds="True">
                <Border.Effect><DropShadowEffect BlurRadius="38" ShadowDepth="8" Opacity="0.58" Color="#000000" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <Grid Margin="28,24,28,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Smart signal routing" />
                                <Border Margin="10,3,0,0" Padding="8,4" CornerRadius="6" Background="#17312F" VerticalAlignment="Top"><TextBlock Foreground="{StaticResource AccentBrush}" FontSize="8" FontWeight="Bold" Text="5.4 ROUTE EDITOR" /></Border>
                            </StackPanel>
                            <TextBlock Margin="0,7,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="One channel, every available provider feed, ranked from real playback history." />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}" Click="CloseSignalRouting_Click" ToolTip="Close signal routing"><TextBlock FontSize="18" Text="×" /></Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="24,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Padding="16,14" CornerRadius="14" Background="#0D131D" BorderBrush="#273247" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Foreground="#7E8DA3" FontSize="8.5" FontWeight="Bold" Text="CHANNEL ROUTE" />
                                        <ComboBox x:Name="SignalRouteChannelBox" Width="430" Height="38" Margin="0,7,0,0" HorizontalAlignment="Left" DisplayMemberPath="DisplayText" SelectionChanged="SignalRouteChannelBox_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Width="310" Margin="24,0,0,0" VerticalAlignment="Center">
                                        <CheckBox x:Name="SignalRoutingAutoCheck" Foreground="#E2E9F3" FontSize="11" FontWeight="SemiBold" Click="SignalRoutingAutoCheck_Click" Content="Automatic backup-feed switching" />
                                        <TextBlock Margin="23,5,0,0" Foreground="#708096" FontSize="9" LineHeight="14" Text="Switch only after native reconnect and decoder recovery are exhausted." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Margin="0,12,0,12" Padding="16,12" CornerRadius="12" Background="#10201F" BorderBrush="#28504C" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="SignalRouteHeadingText" Foreground="#E8F0F8" FontSize="13" FontWeight="SemiBold" Text="Select a channel route" />
                                            <TextBlock x:Name="SignalRouteSummaryText" Margin="0,5,0,0" Foreground="#85A8A5" FontSize="9.5" Text="Feed scores improve as StreamVue observes real playback." />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="9,5" CornerRadius="7" Background="#17312F">
                                            <TextBlock x:Name="SignalRouteStatusText" Foreground="{StaticResource AccentBrush}" FontSize="8.5" FontWeight="Bold" Text="READY" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#79A39F" FontSize="8.5" FontWeight="Bold" Text="MANUAL ROUTE EDITOR" />
                                        <ComboBox x:Name="SignalRouteCandidateBox" Grid.Column="1" Height="34" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayText" DisplayMemberPath="DisplayText" ToolTip="Search any playlist feed by channel or source name" />
                                        <Button Grid.Column="2" Margin="10,0,0,0" Padding="12,7" Style="{StaticResource SecondaryButton}" Click="LinkSignalFeed_Click" Content="Link feed" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <ListBox x:Name="SignalRouteList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,9" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="SignalFeedCard" Padding="16,14" CornerRadius="14" Background="#0D131D" BorderBrush="#273247" BorderThickness="1">
