                                        <TextBlock x:Name="ReminderChannel" Margin="0,4,0,0" Foreground="#8B9BB2" FontSize="10" />
                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                            <Button Padding="12,7" Style="{StaticResource PrimaryButton}" Click="WatchReminder_Click" Content="Watch now" />
                                            <Button Margin="7,0,0,0" Padding="12,7" Style="{StaticResource SecondaryButton}" Click="DismissReminder_Click" Content="Dismiss" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="FullscreenHint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Padding="13,8" Panel.ZIndex="5" Style="{StaticResource SecondaryButton}" Background="#D9121924" BorderBrush="#52627A" Click="ToggleFullscreen_Click" Visibility="Collapsed" ToolTip="Exit fullscreen">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,9,0" Foreground="{StaticResource AccentBrush}" FontSize="14" Text="⛶" />
                                        <TextBlock VerticalAlignment="Center" Foreground="#E5EDF8" FontSize="9.5" FontWeight="SemiBold" Text="F11  /  ESC  TO EXIT FULLSCREEN" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </vlc:VideoView>

                        <StackPanel x:Name="EmptyPlayerState" Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                            <Grid Width="88" Height="88" HorizontalAlignment="Center">
                                <Ellipse Fill="#101722" Stroke="#263348" StrokeThickness="1" />
                                <Ellipse Width="53" Height="53" Fill="#172532" />
                                <Path Data="M 35,24 L 35,54 L 59,39 Z" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Margin="24" />
                            </Grid>
                            <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="A better signal path" />
                            <TextBlock Margin="0,8,0,0" TextAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12" LineHeight="19" Text="Direct MPEG-TS and HLS playback through the native Windows video pipeline—without Chromium transcoding in the middle." TextWrapping="Wrap" />
                            <Button Margin="0,20,0,0" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="OpenImport_Click" Content="Connect a playlist" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,10" CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="#212B3B" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Width="42" Height="42" Background="{StaticResource AccentBrush}" Foreground="#071110" Click="PlayPause_Click" ToolTip="Play or pause">
                            <TextBlock x:Name="PlayPauseGlyph" FontSize="17" Text="▶" />
                        </Button>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Width="42" Height="42" Click="Stop_Click" ToolTip="Stop">
                                <TextBlock FontSize="14" Text="■" />
                            </Button>
                            <Button Margin="4,0,0,0" Style="{StaticResource IconButton}" Width="42" Height="42" Click="RetryPlayback_Click" ToolTip="Reconnect now">
                                <TextBlock FontSize="19" Text="↻" />
                            </Button>
                            <Button Margin="4,0,0,0" Style="{StaticResource IconButton}" Width="42" Height="42" Foreground="#B9AFFF" Click="StabilizePlayback_Click" ToolTip="Stabilize stream with an 8-second cache">
                                <TextBlock FontSize="18" FontWeight="Bold" Text="≋" />
                            </Button>
                            <Button x:Name="RecordButton" Margin="4,0,0,0" Style="{StaticResource IconButton}" Width="42" Height="42" Foreground="#FF6277" Click="ToggleRecording_Click" ToolTip="Record this live channel">
                                <TextBlock x:Name="RecordButtonGlyph" FontSize="17" Text="●" />
                            </Button>
                            <Button x:Name="Rewind10Button" Margin="4,0,0,0" Style="{StaticResource IconButton}" Width="42" Height="42" Foreground="#75B9FF" Tag="10" Click="RewindLive_Click" ToolTip="Rewind live TV 10 seconds" Visibility="Collapsed">
                                <TextBlock FontSize="9" FontWeight="Bold" Text="−10" />
                            </Button>
                            <Button x:Name="Rewind60Button" Margin="2,0,0,0" Style="{StaticResource IconButton}" Width="42" Height="42" Foreground="#75B9FF" Tag="60" Click="RewindLive_Click" ToolTip="Rewind live TV 60 seconds" Visibility="Collapsed">
                                <TextBlock FontSize="9" FontWeight="Bold" Text="−60" />
                            </Button>
                            <Button x:Name="GoLiveButton" Margin="2,0,0,0" Style="{StaticResource IconButton}" Width="46" Height="42" Foreground="{StaticResource AccentBrush}" Click="GoLive_Click" ToolTip="Return to the live edge" Visibility="Collapsed">
                                <TextBlock FontSize="8" FontWeight="Bold" Text="LIVE" />
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PlaybackStatusText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="IDLE" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="PlaybackDetailText" Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Text="No channel selected" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                            <Grid x:Name="RecordingSeekPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="RecordingPositionText" VerticalAlignment="Center" Foreground="#8E9DB1" FontSize="8.5" Text="0:00" />
                                <Slider x:Name="PlaybackSeekSlider" Grid.Column="1" Height="15" Margin="9,0" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" PreviewMouseLeftButtonDown="PlaybackSeekSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="PlaybackSeekSlider_PreviewMouseLeftButtonUp" KeyUp="PlaybackSeekSlider_KeyUp" Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="Playback position" />
                                <TextBlock x:Name="RecordingDurationText" Grid.Column="2" VerticalAlignment="Center" Foreground="#8E9DB1" FontSize="8.5" Text="0:00" />
                            </Grid>
                            <Grid x:Name="TimeshiftPanel" Margin="0,5,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TimeshiftStatusText" VerticalAlignment="Center" Foreground="#75B9FF" FontSize="8.5" FontWeight="SemiBold" Text="LIVE BUFFER READY" />
                                <ProgressBar x:Name="TimeshiftWindowProgress" Grid.Column="1" Height="3" Margin="10,0" Minimum="0" Maximum="100" Value="0" Foreground="#75B9FF" Background="#253145" />
                                <TextBlock x:Name="TimeshiftWindowText" Grid.Column="2" VerticalAlignment="Center" Foreground="#718198" FontSize="8.5" Text="60 MIN" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Click="Mute_Click" ToolTip="Mute">
                                <TextBlock x:Name="VolumeGlyph" FontSize="17" Text="◖" />
                            </Button>
                            <Slider x:Name="VolumeSlider" Width="94" Minimum="0" Maximum="100" Value="82" ValueChanged="VolumeSlider_ValueChanged" Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="Volume" />
                        </StackPanel>
                        <ComboBox x:Name="AspectBox" Grid.Column="4" Width="92" Margin="16,0,0,0" SelectionChanged="AspectBox_SelectionChanged" ToolTip="Aspect ratio" AutomationProperties.Name="Aspect ratio" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Signal inspector -->
            <Border x:Name="InspectorPanel" Grid.Column="3" Background="#0B0F17" BorderBrush="#1A2230" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,20">
                        <Grid Margin="2,0,2,14">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Signal desk" />
                            <Border HorizontalAlignment="Right" Padding="7,3" CornerRadius="5" Background="#172432">
                                <TextBlock Foreground="#75B9FF" FontSize="8.5" FontWeight="Bold" Text="REALTIME" />
                            </Border>
                        </Grid>

                        <Border Padding="16" CornerRadius="14" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="#273246" BorderThickness="1">
                            <StackPanel>
                                <Grid Width="56" Height="56" HorizontalAlignment="Left">
                                    <Border CornerRadius="14" Background="{StaticResource AccentGradient}" Opacity="0.18" />
                                    <TextBlock x:Name="InspectorInitials" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold" Text="KN" />
                                </Grid>
                                <TextBlock x:Name="InspectorChannelName" Margin="0,14,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Nothing playing" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="InspectorGroupName" Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Select a channel" TextTrimming="CharacterEllipsis" />
                                <Border x:Name="InspectorGuideCard" Margin="0,14,0,0" Padding="11,9" CornerRadius="9" Background="#0D1822" BorderBrush="#23413F" BorderThickness="1" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="8" FontWeight="Bold" Text="NOW ON" />
                                        <TextBlock x:Name="InspectorProgramText" Margin="0,5,0,0" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="InspectorNextText" Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="9.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="CurrentFavoriteButton" Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" MinHeight="32" Padding="11,6" Click="ToggleCurrentFavorite_Click" Content="☆ Add favorite" Visibility="Collapsed" />
                                <Button x:Name="SignalRoutesButton" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" MinHeight="32" Padding="11,6" Foreground="{StaticResource AccentBrush}" Click="OpenSignalRouting_Click" Content="◉ Choose feed &amp; history" Visibility="Collapsed" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Border Padding="7,4" Margin="0,0,6,6" CornerRadius="5" Background="#17312F">
                                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="8.5" FontWeight="Bold" Text="NATIVE" />
                                    </Border>
                                    <Border Padding="7,4" Margin="0,0,6,6" CornerRadius="5" Background="#282440">
                                        <TextBlock x:Name="DecoderBadgeText" Foreground="#B9AFFF" FontSize="8.5" FontWeight="Bold" Text="HW AUTO" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="2,22,0,10" Foreground="#7E8DA3" FontSize="9.5" FontWeight="Bold" Text="P L A Y B A C K   T E L E M E T R Y" />
                        <Border Padding="15,6" CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="#222C3D" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Engine" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="LibVLC 3" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Decode" />
                                    <TextBlock x:Name="DecodeValue" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="10.5" FontWeight="SemiBold" Text="Hardware auto" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Network cache" />
                                    <TextBlock x:Name="CacheValue" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="4.0 seconds" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Tune strategy" />
                                    <TextBlock x:Name="TuneStrategyValue" MaxWidth="150" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="Smart tune" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Active feed" />
                                    <TextBlock x:Name="ActiveFeedValue" MaxWidth="150" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="#75B9FF" Text="—" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Startup" />
                                    <TextBlock x:Name="StartupValue" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="—" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Video" />
                                    <TextBlock x:Name="VideoFormatValue" MaxWidth="150" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="—" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Frame rate" />
                                    <TextBlock x:Name="FrameRateValue" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="—" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Input bitrate" />
                                    <TextBlock x:Name="BitrateValue" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="—" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Audio" />
                                    <TextBlock x:Name="AudioFormatValue" MaxWidth="150" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="—" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Stream state" />
                                    <TextBlock x:Name="StreamStateValue" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Idle" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Buffer events" />
                                    <TextBlock x:Name="BufferEventsValue" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="0" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Reconnects" />
                                    <TextBlock x:Name="ReconnectsValue" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="0" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Recovery" />
                                    <TextBlock x:Name="RecoveryValue" MaxWidth="155" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="#B9AFFF" Text="No interventions" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Dropped frames" />
                                    <TextBlock x:Name="DroppedFramesValue" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="0" />
                                </Grid>
                                <Border Height="1" Background="#202A39" />
                                <Grid Margin="0,9">
                                    <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Display cadence" />
                                    <TextBlock x:Name="DisplayRateValue" MaxWidth="150" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Display default" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="2,22,0,10" Foreground="#7E8DA3" FontSize="9.5" FontWeight="Bold" Text="N A T I V E   A D V A N T A G E S" />
                        <Border Padding="15" CornerRadius="14" Background="#101822" BorderBrush="#213448" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Foreground="#C5D4E8" FontSize="11" FontWeight="SemiBold" Text="Direct transport-stream playback" />
                                <TextBlock Margin="0,5,0,12" Foreground="{StaticResource TextMutedBrush}" FontSize="10" LineHeight="15" Text="No browser remux layer between the provider and decoder." TextWrapping="Wrap" />
                                <TextBlock Foreground="#C5D4E8" FontSize="11" FontWeight="SemiBold" Text="Device-aware decoding" />
                                <TextBlock Margin="0,5,0,12" Foreground="{StaticResource TextMutedBrush}" FontSize="10" LineHeight="15" Text="Uses the GPU when the codec and driver support it." TextWrapping="Wrap" />
                                <TextBlock Foreground="#C5D4E8" FontSize="11" FontWeight="SemiBold" Text="Audio passthrough ready" />
                                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10" LineHeight="15" Text="Designed for HDMI surround and Atmos-capable paths." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Native TV guide -->
            <Grid x:Name="GuideWorkspace" Grid.Column="1" Grid.ColumnSpan="3" Panel.ZIndex="5" Background="#090D14" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="30,24,30,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="TV Guide" />
                            <Border Margin="12,3,0,0" Padding="8,4" CornerRadius="6" Background="#17312F" VerticalAlignment="Top">
                                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="8.5" FontWeight="Bold" Text="TIMELINE + NOW/NEXT" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="GuideStatusText" Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Connect a playlist to prepare guide listings." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="OpenGuideMapping_Click" Content="Map listings" />
                        <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="OpenGuideSource_Click" Content="Guide sources" />
                        <Button Style="{StaticResource PrimaryButton}" Click="RefreshGuide_Click" Content="Refresh guide" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="30,0,30,14" Padding="14,11" CornerRadius="12" Background="#101722" BorderBrush="#263144" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="158" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="GuideSearchBox" Height="38" Padding="35,8,11,8" TextChanged="GuideSearchBox_TextChanged" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#66758B" FontSize="16" IsHitTestVisible="False" Text="⌕" />
                        </Grid>
                        <ComboBox x:Name="GuideFilterBox" Grid.Column="1" Margin="10,0,0,0" Height="38" SelectionChanged="GuideFilterBox_SelectionChanged" SelectedIndex="0">
                            <ComboBoxItem Content="All live channels" Tag="All" />
                            <ComboBoxItem Content="Favorites" Tag="Favorites" />
                            <ComboBoxItem Content="Sports" Tag="Sports" />
                            <ComboBoxItem Content="Movies" Tag="Movies" />
                            <ComboBoxItem Content="News" Tag="News" />
                            <ComboBoxItem Content="Needs mapping" Tag="Unmatched" />
                        </ComboBox>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0" Orientation="Horizontal">
                            <Button x:Name="GuideTimelineViewButton" Margin="0,0,6,0" Padding="12,8" Style="{StaticResource SecondaryButton}" Click="GuideTimelineView_Click" Content="Timeline" />
                            <Button x:Name="GuideListViewButton" Padding="12,8" Style="{StaticResource SecondaryButton}" Click="GuideListView_Click" Content="Now / Next" Opacity="0.62" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="14,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button Width="30" Height="28" Padding="0" Style="{StaticResource SecondaryButton}" Click="GuidePreviousWindow_Click" Content="‹" ToolTip="Earlier listings" />
                            <Button Margin="6,0" Padding="11,6" Style="{StaticResource SecondaryButton}" Click="GuideJumpNow_Click" Content="Now" />
                            <Button Width="30" Height="28" Padding="0" Style="{StaticResource SecondaryButton}" Click="GuideNextWindow_Click" Content="›" ToolTip="Later listings" />
                            <TextBlock x:Name="GuideWindowText" Margin="11,0,0,0" MinWidth="220" VerticalAlignment="Center" Foreground="#91A0B5" FontSize="9" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="GuideCoverageText" Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" Text="0 channels ready" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="30,0,30,24">
                    <Grid x:Name="GuideTimelinePanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="245" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="16,0" CornerRadius="10,0,0,0" Background="#121A26" BorderBrush="#273246" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Foreground="#7E8DA3" FontSize="9" FontWeight="Bold" Text="CHANNEL" />
                                <TextBlock Margin="0,3,0,0" Foreground="#56667C" FontSize="8.5" Text="Live guide lineup" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="0,10,0,0" Background="#121A26" BorderBrush="#273246" BorderThickness="0,1,1,1">
                            <Grid>
                                <ScrollViewer x:Name="GuideTimeHeaderScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsHitTestVisible="False">
                                    <ItemsControl x:Name="GuideTimeHeader" Height="48">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}" /></Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}" Height="48" Padding="10,7" BorderBrush="#263246" BorderThickness="0,0,1,0">
                                                    <StackPanel>
                                                        <TextBlock Foreground="#D3DDEA" FontSize="10" FontWeight="SemiBold" Text="{Binding TimeLabel}" />
                                                        <TextBlock Margin="0,3,0,0" Foreground="#607087" FontSize="8" Text="{Binding DateLabel}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#0D131D" BorderBrush="#273246" BorderThickness="1,0,1,1">
                            <ScrollViewer x:Name="GuideChannelScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ScrollChanged="GuideChannelScroll_ScrollChanged">
                                <ItemsControl x:Name="GuideTimelineChannels">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TimelineChannelCard" Height="76" Padding="12,0" Background="#0D131D" BorderBrush="#1D2837" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="9" Background="#192433" BorderBrush="#2B3A50" BorderThickness="1">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B8C5D8" FontSize="9.5" FontWeight="Bold" Text="{Binding Initials}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,5,0" VerticalAlignment="Center">
                                                        <TextBlock Foreground="{StaticResource TextBrush}" FontSize="10.5" FontWeight="SemiBold" Text="{Binding ChannelName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,3,0,0" Foreground="#67778D" FontSize="8.5" Text="{Binding Group}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource AccentBrush}" FontSize="7.5" FontWeight="Bold" Text="{Binding MappingStatus}" />
                                                    </StackPanel>
                                                    <Button x:Name="TimelineMapButton" Grid.Column="2" Padding="8,5" Style="{StaticResource SecondaryButton}" Click="GuideMapChannel_Click" Content="Map" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding CanMap}" Value="True"><Setter TargetName="TimelineMapButton" Property="Visibility" Value="Visible" /></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Background="#0B1119" BorderBrush="#273246" BorderThickness="0,0,1,1">
                            <ScrollViewer x:Name="GuideTimelineScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" ScrollChanged="GuideTimelineScroll_ScrollChanged">
                                <ItemsControl x:Name="GuideTimelineRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas Width="{Binding TimelineWidth}" Height="76" Background="#0B1119">
                                                <ItemsControl ItemsSource="{Binding Blocks}" Width="{Binding TimelineWidth}" Height="76">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}" /><Setter Property="Canvas.Top" Value="6" /></Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Width="{Binding Width}" Height="64" Padding="11,8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="GuideProgramme_Click" ToolTip="Watch now • right-click for reminder and recording options">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Foreground" Value="#DCE5F2" />
                                                                        <Setter Property="Background" Value="#151E2B" />
                                                                        <Setter Property="BorderBrush" Value="#29374B" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Border x:Name="ProgrammeCard" Padding="{TemplateBinding Padding}" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ProgrammeCard" Property="Background" Value="#1C2A39" /><Setter TargetName="ProgrammeCard" Property="BorderBrush" Value="#3B556B" /></Trigger>
                                                                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ProgrammeCard" Property="Opacity" Value="0.78" /></Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#12312F" /><Setter Property="BorderBrush" Value="#2FCBBB" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPast}" Value="True"><Setter Property="Opacity" Value="0.52" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="Background" Value="#111720" /><Setter Property="BorderBrush" Value="#3B4658" /><Setter Property="Opacity" Value="0.74" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <Button.ContextMenu>
                                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Background="#121A26" Foreground="#E3EAF4" BorderBrush="#344158" BorderThickness="1" Padding="4">
                                                                        <MenuItem Header="Watch now" Click="GuideContextWatch_Click" />
                                                                        <MenuItem Header="Watch replay" Click="GuideContextReplay_Click" IsEnabled="{Binding CanReplay}" />
                                                                        <Separator Background="#344158" />
                                                                        <MenuItem Header="Set or remove reminder" Click="GuideContextReminder_Click" />
                                                                        <MenuItem Header="Schedule or cancel recording" Click="GuideContextRecording_Click" />
                                                                        <MenuItem Header="Record or stop recording this series" Click="GuideContextSeriesRecording_Click" />
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                                <StackPanel>
                                                                    <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Margin="0,4,0,0" Foreground="#8190A5" FontSize="8.5" Text="{Binding Time}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="7.5" Text="{Binding Category}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Canvas.Left="{Binding NowMarkerLeft}" Panel.ZIndex="5" Width="2" Height="76" Background="{StaticResource AccentBrush}" Opacity="0.7">
                                                    <Border.Style>
                                                        <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowNowMarker}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                                    </Border.Style>
                                                </Border>
                                                <Border Canvas.Top="75" Width="{Binding TimelineWidth}" Height="1" Background="#1D2837" />
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid x:Name="GuideListPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="16,9" CornerRadius="10,10,0,0" Background="#121A26" BorderBrush="#273246" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="245" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                                <TextBlock Foreground="#7E8DA3" FontSize="9" FontWeight="Bold" Text="CHANNEL" />
                                <TextBlock Grid.Column="1" Foreground="#7E8DA3" FontSize="9" FontWeight="Bold" Text="ON NOW" />
                                <TextBlock Grid.Column="2" Foreground="#7E8DA3" FontSize="9" FontWeight="Bold" Text="UP NEXT" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="GuideList" Grid.Row="1" Background="#0C111A" BorderBrush="#273246" BorderThickness="1,0,1,1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="GuideList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="GuideRowCard" Padding="16,12" Background="Transparent" BorderBrush="#1C2635" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="245" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="38" Height="38" CornerRadius="9" Background="#192433" BorderBrush="#2B3A50" BorderThickness="1"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B8C5D8" FontSize="10" FontWeight="Bold" Text="{Binding Initials}" /></Border><StackPanel Margin="11,0,8,0" VerticalAlignment="Center"><TextBlock Foreground="{StaticResource TextBrush}" FontSize="11.5" FontWeight="SemiBold" Text="{Binding ChannelName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" Foreground="#718096" FontSize="9" Text="{Binding Group}" TextTrimming="CharacterEllipsis" /></StackPanel></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,22,0" VerticalAlignment="Center"><TextBlock Foreground="#E3EBF6" FontSize="11.5" FontWeight="SemiBold" Text="{Binding CurrentTitle}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,4,0,5" Foreground="{StaticResource AccentBrush}" FontSize="9" Text="{Binding CurrentTime}" /><ProgressBar Height="3" Maximum="100" Value="{Binding CurrentProgress}" Foreground="{StaticResource AccentBrush}" Background="#263246" /></StackPanel>
                                            <StackPanel Grid.Column="2" Margin="0,0,22,0" VerticalAlignment="Center"><TextBlock Foreground="#AEBACC" FontSize="11" FontWeight="SemiBold" Text="{Binding NextTitle}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,4,0,0" Foreground="#718096" FontSize="9" Text="{Binding NextTime}" /></StackPanel>
                                            <Button Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="12,7" Click="GuideWatch_Click" Content="Watch" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers><DataTrigger Binding="{Binding HasSchedule}" Value="False"><Setter TargetName="GuideRowCard" Property="Opacity" Value="0.67" /></DataTrigger><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="GuideRowCard" Property="Background" Value="#141D29" /></DataTrigger></DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <StackPanel x:Name="GuideEmptyState" Panel.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                        <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="36" Text="▦" />
                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Guide data is being prepared" />
                        <TextBlock Margin="0,7,0,0" TextAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11" LineHeight="17" Text="StreamVue can use an advertised XMLTV source, a local file, or the verified US guide pack." TextWrapping="Wrap" />
                        <Button Margin="0,17,0,0" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="OpenGuideSource_Click" Content="Choose guide source" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Native multiview workspace -->
            <Grid x:Name="MultiviewWorkspace" Grid.Column="2" Grid.ColumnSpan="2" Panel.ZIndex="6" Background="#090D14" Visibility="Collapsed">
                <Grid.Resources>
                    <ItemsPanelTemplate x:Key="MultiviewDuoPanel"><UniformGrid Rows="1" Columns="2" /></ItemsPanelTemplate>
                    <ItemsPanelTemplate x:Key="MultiviewQuadPanel"><UniformGrid Rows="2" Columns="2" /></ItemsPanelTemplate>
                    <ItemsPanelTemplate x:Key="MultiviewFocusPanel"><UniformGrid Rows="1" Columns="1" /></ItemsPanelTemplate>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="MultiviewHeaderRow" Height="Auto" />
                    <RowDefinition x:Name="MultiviewStatusRow" Height="Auto" />
                    <RowDefinition x:Name="MultiviewContentRow" Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="26,22,26,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Multiview" />
                            <Border Margin="12,3,0,0" Padding="8,4" CornerRadius="6" Background="#17312F" VerticalAlignment="Top">
                                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="8.5" FontWeight="Bold" Text="NATIVE MULTI-SIGNAL" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="MultiviewStatusText" Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Select a view, then choose a channel from the library." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MultiviewDuoButton" Margin="0,0,7,0" Padding="11,8" Style="{StaticResource SecondaryButton}" Click="MultiviewDuo_Click" Content="2-UP" />
                        <Button x:Name="MultiviewQuadButton" Margin="0,0,7,0" Padding="11,8" Style="{StaticResource SecondaryButton}" Click="MultiviewQuad_Click" Content="4-UP" />
                        <Button x:Name="MultiviewFocusButton" Margin="0,0,12,0" Padding="11,8" Style="{StaticResource SecondaryButton}" Click="MultiviewFocus_Click" Content="FOCUS" />
                        <TextBox x:Name="MultiviewLayoutNameBox" Width="106" Height="34" Margin="0,0,6,0" Padding="9,7" FontSize="9.5" Text="My layout" ToolTip="Name this Multiview layout" />
                        <Button Margin="0,0,6,0" Padding="10,7" Style="{StaticResource SecondaryButton}" Click="MultiviewSaveLayout_Click" Content="Save" ToolTip="Save channel assignments and layout" />
                        <ComboBox x:Name="MultiviewSavedLayoutsBox" Width="116" Height="34" Margin="0,0,6,0" DisplayMemberPath="Name" ToolTip="Saved Multiview layouts" />
                        <Button Margin="0,0,12,0" Padding="10,7" Style="{StaticResource SecondaryButton}" Click="MultiviewLoadLayout_Click" Content="Load" />
                        <Button Margin="0,0,7,0" Style="{StaticResource SecondaryButton}" Click="MultiviewClearAll_Click" Content="Clear all" />
                        <Button Style="{StaticResource IconButton}" Background="{StaticResource SurfaceRaisedBrush}" Click="ToggleFullscreen_Click" ToolTip="True fullscreen multiview (F11 or Alt+Enter)">
                            <TextBlock FontSize="18" Text="⛶" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="26,0,26,10" Padding="13,9" CornerRadius="11" Background="#101722" BorderBrush="#263144" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MultiviewActiveText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#DCE6F2" FontSize="10" FontWeight="SemiBold" Text="VIEW 1 SELECTED" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Margin="18,0" VerticalAlignment="Center" Foreground="#718096" FontSize="9.5" Text="One audio feed at a time • hidden views enter standby • provider connection limits still apply" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Foreground="#718096" FontSize="9" Text="KEYS" />
                            <Border Margin="8,0,0,0" Padding="7,3" CornerRadius="5" Background="#182131"><TextBlock Foreground="#AAB8CB" FontSize="8.5" Text="1–4 SELECT" /></Border>
                            <Border Margin="5,0,0,0" Padding="7,3" CornerRadius="5" Background="#182131"><TextBlock Foreground="#AAB8CB" FontSize="8.5" Text="M AUDIO" /></Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl x:Name="MultiviewTiles" Grid.Row="2" Margin="18,0,18,18" ItemsPanel="{StaticResource MultiviewQuadPanel}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="VerticalAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TileFrame" Background="#020305" ClipToBounds="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="7" />
                                        <Setter Property="CornerRadius" Value="16" />
                                        <Setter Property="BorderBrush" Value="#273246" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="Effect">
                                                    <Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.22" Color="#35E7D3" /></Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFullscreen}" Value="True">
                                                <Setter Property="Margin" Value="1" />
                                                <Setter Property="CornerRadius" Value="0" />
                                                <Setter Property="Effect" Value="{x:Null}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Background="#020305" AllowDrop="True" MouseLeftButtonDown="MultiviewTile_MouseLeftButtonDown" PreviewMouseMove="MultiviewTile_PreviewMouseMove" Drop="MultiviewTile_Drop">
                                    <Grid.RowDefinitions>
                                        <RowDefinition>
                                            <RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="42" /><Style.Triggers><DataTrigger Binding="{Binding IsFullscreen}" Value="True"><Setter Property="Height" Value="0" /></DataTrigger></Style.Triggers></Style></RowDefinition.Style>
                                        </RowDefinition>
                                        <RowDefinition Height="*" />
                                        <RowDefinition>
                                            <RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="58" /><Style.Triggers><DataTrigger Binding="{Binding IsFullscreen}" Value="True"><Setter Property="Height" Value="0" /></DataTrigger></Style.Triggers></Style></RowDefinition.Style>
                                        </RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Border Padding="12,0" Background="#0B1119" BorderBrush="#223044" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding StatusBrush}" />
                                            <StackPanel Grid.Column="1" Margin="9,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Foreground="#F0F4FA" FontSize="10.5" FontWeight="SemiBold" Text="{Binding ChannelName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="8,0,0,0" Foreground="#718096" FontSize="8.5" Text="{Binding GroupName, StringFormat=• {0}}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ProgressBar x:Name="TileBuffer" Width="44" Height="3" Margin="0,0,9,0" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}">
                                                    <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsBuffering}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
                                                </ProgressBar>
                                                <TextBlock Foreground="{Binding StatusBrush}" FontSize="8.5" FontWeight="Bold" Text="{Binding Status}" />
                                                <Border Margin="9,0,0,0" Padding="7,3" CornerRadius="5" Background="#17202D"><TextBlock Foreground="#B9C5D6" FontSize="8" FontWeight="Bold" Text="{Binding Number, StringFormat=VIEW {0}}" /></Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <controls:MultiviewVideoHost Grid.Row="1" MediaPlayer="{Binding MediaPlayer}">
                                        <controls:MultiviewVideoHost.Style>
                                            <Style TargetType="controls:MultiviewVideoHost"><Style.Triggers><DataTrigger Binding="{Binding HasChannel}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
                                        </controls:MultiviewVideoHost.Style>
                                    </controls:MultiviewVideoHost>

                                    <Border Grid.Row="2" Padding="11,8" Background="#0B1119" BorderBrush="#223044" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="8" Background="#182433"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold" Text="{Binding Initials}" /></Border>
                                            <TextBlock Grid.Column="1" Margin="9,0,10,0" VerticalAlignment="Center" Foreground="#7E8DA3" FontSize="8.5" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="TileAudioButton" Margin="0,0,5,0" Padding="9,6" Click="MultiviewAudio_Click" Content="Audio"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsAudible}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="#17312F" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                                <Button Margin="0,0,5,0" Padding="9,6" Style="{StaticResource SecondaryButton}" Click="MultiviewSwap_Click" Content="Swap" ToolTip="Swap with the selected view" />
                                                <Button Margin="0,0,5,0" Padding="9,6" Style="{StaticResource SecondaryButton}" Click="MultiviewTileFocus_Click" Content="Expand" />
                                                <Button Width="30" Height="30" Padding="0" Style="{StaticResource IconButton}" Click="MultiviewClear_Click" ToolTip="Clear this view"><TextBlock FontSize="14" Text="×" /></Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid x:Name="EmptyTileOverlay" Grid.RowSpan="3" Panel.ZIndex="2" Background="#060A10">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                                            <Grid Width="58" Height="58" HorizontalAlignment="Center"><Border CornerRadius="15" Background="#121B27" BorderBrush="#2A3A50" BorderThickness="1" /><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#60718A" FontSize="24" Text="＋" /></Grid>
                                            <TextBlock Margin="0,13,0,0" HorizontalAlignment="Center" Foreground="#E0E7F1" FontSize="13" FontWeight="SemiBold" Text="{Binding ChannelName}" />
                                            <TextBlock Margin="0,5,0,0" TextAlignment="Center" Foreground="#718096" FontSize="9.5" Text="Select this view, then choose a channel from the library." TextWrapping="Wrap" />
                                            <Button Margin="0,12,0,0" HorizontalAlignment="Center" Padding="12,7" Style="{StaticResource SecondaryButton}" Click="MultiviewSelectTile_Click" Content="Select view" />
                                        </StackPanel>
                                        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasChannel}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#090D14" BorderBrush="#192130" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="FooterStatusDot" Width="6" Height="6" Fill="#5B687C" />
                    <TextBlock x:Name="FooterStatusText" Margin="8,0,0,0" Foreground="#7E8CA1" FontSize="9.5" Text="StreamVue is ready" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#566176" FontSize="9" Text="F11 TRUE FULLSCREEN" />
                    <Border Width="1" Height="12" Margin="12,0" Background="#283244" />
                    <TextBlock Foreground="#566176" FontSize="9" Text="Q QUICK TUNE" />
                    <Border Width="1" Height="12" Margin="12,0" Background="#283244" />
                    <TextBlock Foreground="#566176" FontSize="9" Text="↑↓ CHANNELS • BACKSPACE LAST" />
                    <Border Width="1" Height="12" Margin="12,0" Background="#283244" />
                    <TextBlock Foreground="#566176" FontSize="9" Text="5.4 MEDIA SYNC" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Source connection modal -->
        <Grid x:Name="ImportOverlay" Grid.RowSpan="3" Panel.ZIndex="90" Background="#F0080B12" Visibility="Collapsed">
            <Border Width="900" MaxHeight="780" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" CornerRadius="22" Background="#111722" BorderBrush="#344158" BorderThickness="1" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.55" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Connect your sources" />
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Text="Connect IPTV or your personal Plex and Emby libraries. Credentials stay protected on this PC." />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}" Click="CloseImport_Click" ToolTip="Close source manager">
                            <TextBlock FontSize="18" Text="×" />
                        </Button>
                    </Grid>

                    <TabControl x:Name="SourceTabs" Grid.Row="1" Margin="0,24,0,20" Background="Transparent" BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="14,9" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="TabRoot" Margin="0,0,6,0" Padding="{TemplateBinding Padding}" CornerRadius="9" Background="{TemplateBinding Background}">
                                                <ContentPresenter ContentSource="Header" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabRoot" Property="Background" Value="{StaticResource AccentDimBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <TabItem x:Name="SavedSourcesTab" Header="My sources">
                            <Grid Margin="2,20,2,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Your channel sources" />
                                        <TextBlock x:Name="SourceManagerSummaryText" Margin="0,5,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Add an M3U, Xtream, Plex, or Emby source to begin." />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7" Style="{StaticResource SecondaryButton}" Click="AddPlaylistSource_Click" Content="+ Add source" />
                                </Grid>
                                <Border Grid.Row="1" Margin="0,13,0,10" Padding="12,9" CornerRadius="10" Background="#10211F" BorderBrush="#21443F" BorderThickness="1">
                                    <TextBlock Foreground="#8EDDD3" FontSize="9.5" Text="Enabled sources become one library. Exact duplicate channels are removed automatically, while every source keeps its own encrypted offline copy." TextWrapping="Wrap" />
                                </Border>
                                <Grid Grid.Row="2" MinHeight="150">
                                    <TextBlock x:Name="SourceManagerEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#66758B" FontSize="10.5" Text="No sources saved yet" Visibility="Collapsed" />
                                    <ListBox x:Name="PlaylistSourceList" MaxHeight="330" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,8" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="14,12" CornerRadius="12" Background="#0D141E" BorderBrush="#273247" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Margin="0,2,12,0" VerticalAlignment="Top" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Tag="{Binding}" Click="SourceEnabled_Click" ToolTip="Include this source in the unified library" />
                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock MaxWidth="170" Foreground="#E7EDF6" FontSize="11.5" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                <Border Margin="9,-1,0,0" Padding="6,3" CornerRadius="5" Background="#17312F">
                                                                    <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="7.5" FontWeight="Bold" Text="{Binding TypeLabel}" />
                                                                </Border>
                                                                <TextBlock Margin="9,1,0,0" Foreground="#7C8BA0" FontSize="8" FontWeight="Bold" Text="{Binding StatusText}" />
                                                            </StackPanel>
                                                            <TextBlock Margin="0,5,12,0" Foreground="#718198" FontSize="9" Text="{Binding DisplayLocation}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayLocation}" />
                                                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                                                <TextBlock Foreground="#9EACBF" FontSize="8.5" Text="{Binding ChannelCountText}" />
                                                                <TextBlock Margin="8,0" Foreground="#46566D" FontSize="8.5" Text="•" />
                                                                <TextBlock Foreground="#718198" FontSize="8.5" Text="{Binding LastRefreshText}" />
                                                                <CheckBox Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#93A3B8" FontSize="8.5" IsChecked="{Binding RefreshOnStartup, Mode=TwoWay}" Tag="{Binding}" Click="SourceStartupRefresh_Click" Content="Refresh at launch" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                            <Button Padding="10,6" Style="{StaticResource PrimaryButton}" Tag="{Binding}" Click="UsePlaylistSource_Click" Content="Use now" />
                                                            <Button Width="30" Height="30" Margin="6,0,0,0" Padding="0" Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="MovePlaylistSourceUp_Click" Content="↑" ToolTip="Move source up" />
                                                            <Button Width="30" Height="30" Margin="5,0,0,0" Padding="0" Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="MovePlaylistSourceDown_Click" Content="↓" ToolTip="Move source down" />
                                                            <Button Width="30" Height="30" Margin="5,0,0,0" Padding="0" Style="{StaticResource SecondaryButton}" Foreground="#FF8997" Tag="{Binding}" Click="RemovePlaylistSource_Click" Content="×" ToolTip="Remove source" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,10,0,0">
                                    <TextBlock VerticalAlignment="Center" Foreground="#65748A" FontSize="8.5" Text="SOURCE ORDER SETS CHANNEL PRIORITY" />
                                    <Button x:Name="SourceRefreshEnabledButton" HorizontalAlignment="Right" Padding="13,7" Style="{StaticResource PrimaryButton}" Click="RefreshEnabledSources_Click" Content="Refresh enabled" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="FileSourceTab" Header="M3U file">
                            <StackPanel Margin="2,24,2,0">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Playlist on this PC" />
                                <TextBlock Margin="0,6,0,14" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Supports .m3u, .m3u8, and IPTV text exports of any size." />
