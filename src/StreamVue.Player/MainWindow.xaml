                                </StackPanel>
                            </Grid>

                            <Border x:Name="CurrentChannelProfileCard" Margin="0,16,0,0" Padding="15,13" CornerRadius="13" Background="#101C24" BorderBrush="#2A5550" BorderThickness="1" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="8.5" FontWeight="Bold" Text="P L A Y B A C K   I Q  •  CURRENT CHANNEL" />
                                            <TextBlock x:Name="CurrentChannelProfileText" Margin="0,6,115,0" Foreground="#AAB8CB" FontSize="10" LineHeight="15" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,6" Style="{StaticResource SecondaryButton}" Click="ResetChannelProfile_Click" Content="Reset learning" />
                                    </Grid>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,6" Foreground="#8FA0B7" FontSize="9" FontWeight="SemiBold" Text="CHANNEL BUFFER" />
                                            <ComboBox x:Name="CurrentChannelBufferBox">
                                                <ComboBoxItem Content="Use PC default" Tag="Default" IsSelected="True" />
                                                <ComboBoxItem Content="Smart" Tag="Smart" />
                                                <ComboBoxItem Content="Responsive" Tag="Responsive" />
                                                <ComboBoxItem Content="Balanced" Tag="Balanced" />
                                                <ComboBoxItem Content="Stable" Tag="Stable" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,6" Foreground="#8FA0B7" FontSize="9" FontWeight="SemiBold" Text="CHANNEL DECODER" />
                                            <ComboBox x:Name="CurrentChannelDecoderBox">
                                                <ComboBoxItem Content="Use PC default" Tag="Default" IsSelected="True" />
                                                <ComboBoxItem Content="Hardware preferred" Tag="Hardware" />
                                                <ComboBoxItem Content="Software only" Tag="Software" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Button Margin="0,12,0,0" HorizontalAlignment="Right" Padding="12,7" Style="{StaticResource PrimaryButton}" Click="ApplyChannelProfile_Click" Content="Apply &amp; retune" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,22,0,9" Foreground="#7E8DA3" FontSize="9.5" FontWeight="Bold" Text="E N G I N E   O P T I O N S" />
                            <Border Padding="17" CornerRadius="14" Background="#0D131D" BorderBrush="#273247" BorderThickness="1">
                                <StackPanel>
                                    <CheckBox x:Name="PlaybackIntelligenceCheck" Foreground="{StaticResource TextBrush}" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged">
                                        <StackPanel Margin="9,0,0,0">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Playback Intelligence" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Learn which channels need more buffer or software decoding and remember the result." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Height="1" Margin="0,14" Background="#222D3E" />
                                    <CheckBox x:Name="FastTuneCheck" Foreground="{StaticResource TextBrush}" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged">
                                        <StackPanel Margin="9,0,0,0">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Fast channel changes" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Start proven channels with a low-latency cache, then expand it automatically if the signal struggles." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Height="1" Margin="0,14" Background="#222D3E" />
                                    <CheckBox x:Name="HardwareDecodeCheck" Foreground="{StaticResource TextBrush}" IsChecked="True" Checked="SettingsChanged" Unchecked="SettingsChanged">
                                        <StackPanel Margin="9,0,0,0">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Hardware decoding" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Prefer Direct3D GPU decoding with safe software fallback." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Height="1" Margin="0,14" Background="#222D3E" />
