                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Frozen-stream watchdog" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Retune when video, audio, and the playback clock stop even if the engine still reports Live." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Height="1" Margin="0,14" Background="#222D3E" />
                                    <CheckBox x:Name="RefreshRateCheck" Foreground="{StaticResource TextBrush}" Checked="SettingsChanged" Unchecked="SettingsChanged">
                                        <StackPanel Margin="9,0,0,0">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="Adaptive display refresh rate" />
                                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="Match this display to the stream cadence and restore its original refresh rate when playback stops." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

