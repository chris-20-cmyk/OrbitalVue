                                                <ComboBoxItem Content="Off" />
                                                <ComboBoxItem Content="Bob" />
                                                <ComboBoxItem Content="Yadif 2×" />
                                                <ComboBoxItem Content="Blend" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
