                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Margin="24,0,18,0" Padding="4,0,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
