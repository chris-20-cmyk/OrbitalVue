                                                        </StackPanel>
                                                        <Button Grid.Column="2" Margin="0,0,7,0" Padding="10,6" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" Click="PrioritizeSeriesRule_Click" Content="{Binding PriorityActionLabel}" />
