        <!-- Channel metadata and observed playback health -->
        <Grid x:Name="ChannelHealthOverlay" Grid.RowSpan="3" Panel.ZIndex="98" Background="#F2080B12" Visibility="Collapsed">
            <Border Width="1040" MaxHeight="790" Margin="22" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="22" Background="#111722" BorderBrush="#344158" BorderThickness="1" ClipToBounds="True">
                <Border.Effect><DropShadowEffect BlurRadius="38" ShadowDepth="8" Opacity="0.58" Color="#000000" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="28,24,28,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Channel health center" />
                                <Border Margin="10,3,0,0" Padding="8,4" CornerRadius="6" Background="#17312F" VerticalAlignment="Top"><TextBlock Foreground="{StaticResource AccentBrush}" FontSize="8" FontWeight="Bold" Text="PRIVATE LOCAL ANALYSIS" /></Border>
                            </StackPanel>
                            <TextBlock Margin="0,7,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Find missing guide data, artwork gaps, weak feeds, duplicate routes, and replay-ready channels." />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}" Click="CloseChannelHealth_Click" ToolTip="Close channel health center"><TextBlock FontSize="18" Text="×" /></Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="24,0,24,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Padding="14,12" CornerRadius="12" Background="#0D141E" BorderBrush="#263144" BorderThickness="1"><StackPanel><TextBlock Foreground="#718198" FontSize="8" FontWeight="Bold" Text="NEEDS ATTENTION" /><TextBlock x:Name="HealthAttentionCount" Margin="0,6,0,0" Foreground="#FF9AA8" FontSize="17" FontWeight="SemiBold" Text="0" /></StackPanel></Border>
                            <Border Grid.Column="2" Padding="14,12" CornerRadius="12" Background="#0D141E" BorderBrush="#263144" BorderThickness="1"><StackPanel><TextBlock Foreground="#718198" FontSize="8" FontWeight="Bold" Text="GUIDE GAPS" /><TextBlock x:Name="HealthGuideCount" Margin="0,6,0,0" Foreground="#F4BD6B" FontSize="17" FontWeight="SemiBold" Text="0" /></StackPanel></Border>
                            <Border Grid.Column="4" Padding="14,12" CornerRadius="12" Background="#0D141E" BorderBrush="#263144" BorderThickness="1"><StackPanel><TextBlock Foreground="#718198" FontSize="8" FontWeight="Bold" Text="DUPLICATE ROUTES" /><TextBlock x:Name="HealthDuplicateCount" Margin="0,6,0,0" Foreground="#B9AFFF" FontSize="17" FontWeight="SemiBold" Text="0" /></StackPanel></Border>
                            <Border Grid.Column="6" Padding="14,12" CornerRadius="12" Background="#0D141E" BorderBrush="#263144" BorderThickness="1"><StackPanel><TextBlock Foreground="#718198" FontSize="8" FontWeight="Bold" Text="REPLAY READY" /><TextBlock x:Name="HealthReplayCount" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}" FontSize="17" FontWeight="SemiBold" Text="0" /></StackPanel></Border>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="HealthChannelSearchBox" Height="38" Padding="12,8" TextChanged="HealthChannelSearchBox_TextChanged" ToolTip="Search channels, groups, or health details" />
                            <ComboBox x:Name="HealthChannelFilterBox" Grid.Column="1" Margin="10,0,0,0" Height="38" SelectionChanged="HealthChannelFilterBox_SelectionChanged" SelectedIndex="0">
                                <ComboBoxItem Content="All channels" Tag="All" />
                                <ComboBoxItem Content="Needs attention" Tag="NeedsAttention" />
                                <ComboBoxItem Content="Missing guide" Tag="MissingGuide" />
                                <ComboBoxItem Content="Missing logo" Tag="MissingLogo" />
                                <ComboBoxItem Content="Unreliable" Tag="Unreliable" />
                                <ComboBoxItem Content="Duplicate routes" Tag="Duplicates" />
                                <ComboBoxItem Content="Replay ready" Tag="Replay" />
                            </ComboBox>
                        </Grid>
                        <ListBox x:Name="ChannelHealthList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="HealthCard" Padding="14,12" CornerRadius="12" Background="#0D131D" BorderBrush="#273247" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="245" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="#192433"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B8C5D8" FontSize="8.5" FontWeight="Bold" Text="{Binding Initials}" /></Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,14,0" VerticalAlignment="Center"><TextBlock Foreground="#E3EAF4" FontSize="11" FontWeight="SemiBold" Text="{Binding ChannelName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,4,0,0" Foreground="#718198" FontSize="8.5" Text="{Binding Group}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock x:Name="HealthStatus" Foreground="{StaticResource AccentBrush}" FontSize="8.5" FontWeight="Bold" Text="{Binding Status}" /><TextBlock Margin="10,0,0,0" Foreground="#7E8DA3" FontSize="8.5" Text="{Binding FeedLabel}" /></StackPanel><TextBlock Margin="0,5,12,0" Foreground="#8290A4" FontSize="9" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                            <Grid Grid.Column="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Margin="0,0,4,0" Padding="9,6" Style="{StaticResource SecondaryButton}" Click="ReviewChannelHealth_Click" Content="Review" /><Button Grid.Column="1" Margin="4,0,0,0" Padding="9,6" Style="{StaticResource PrimaryButton}" Click="TuneChannelHealth_Click" Content="Tune" /></Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers><DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter TargetName="HealthCard" Property="BorderBrush" Value="#584034" /><Setter TargetName="HealthStatus" Property="Foreground" Value="#F4BD6B" /></DataTrigger><DataTrigger Binding="{Binding Unreliable}" Value="True"><Setter TargetName="HealthCard" Property="BorderBrush" Value="#633642" /><Setter TargetName="HealthStatus" Property="Foreground" Value="#FF8997" /></DataTrigger></DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Border Grid.Row="2" Margin="0,18,0,0" Padding="28,16" Background="#0D131D" BorderBrush="#273247" BorderThickness="0,1,0,0"><Grid><TextBlock x:Name="HealthVisibleCount" VerticalAlignment="Center" Foreground="#65748A" FontSize="9.5" Text="0 LIVE CHANNELS ANALYZED" /><Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="CloseChannelHealth_Click" Content="Done" /></Grid></Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Playback settings modal -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Background="#F0080B12" Visibility="Collapsed">
            <Border Width="760" MaxHeight="760" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="22" Background="#111722" BorderBrush="#344158" BorderThickness="1" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.55" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="28,24,28,18">
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="StreamVue settings" />
