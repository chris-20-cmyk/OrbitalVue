                                                <ComboBoxItem Tag="Low" Content="Low" /><ComboBoxItem Tag="Normal" Content="Normal" /><ComboBoxItem Tag="High" Content="High" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions>
