<Window x:Class="StreamVue.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:controls="clr-namespace:StreamVue.Player.Controls"
        mc:Ignorable="d"
        Title="StreamVue"
        Width="1540"
        Height="930"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}"
        Loaded="Window_Loaded"
        Activated="Window_Activated"
        Deactivated="Window_Deactivated"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        MouseMove="Window_MouseMove"
        KeyDown="Window_KeyDown"
        PreviewTextInput="Window_PreviewTextInput">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="ShellRoot" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="FooterRow" Height="34" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="#0A0E16" BorderBrush="#1A2230" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="27" Height="27">
                        <Border CornerRadius="8" Background="{StaticResource AccentGradient}" />
                        <Path Data="M 9,7 L 9,20 L 20,13.5 Z" Fill="#071110" Stretch="Uniform" Margin="7" />
                    </Grid>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextBrush}" Text="S T R E A M V U E" />
                    <Border Margin="10,0,0,0" Padding="7,3" CornerRadius="5" Background="#1A2130">
                        <TextBlock FontSize="9" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Text="PLAYBACK IQ" />
                    </Border>
                </StackPanel>

                <TextBlock x:Name="BroadcastTitle" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#647087" FontSize="11" Text="WINDOWS BROADCAST PLAYER" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DvrNavigationButton" Margin="0,0,8,0" Height="32" Padding="12,0" Style="{StaticResource SecondaryButton}" Click="OpenDvr_Click" ToolTip="Open DVR &amp; recordings">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DvrNavigationDot" Width="7" Height="7" Margin="0,0,7,0" Fill="#FF536A" />
                            <TextBlock x:Name="DvrNavigationText" VerticalAlignment="Center" FontSize="9.5" FontWeight="Bold" Text="DVR" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CastNavigationButton" Margin="0,0,8,0" Height="32" Padding="12,0" Style="{StaticResource SecondaryButton}" Click="OpenCast_Click" ToolTip="Cast to a nearby wireless display (Ctrl+Shift+C)">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                                <Canvas Width="20" Height="20">
                                    <Path Data="M 2,2 L 18,2 L 18,14 L 11,14 M 2,9 C 7,9 11,13 11,18 M 2,13 C 5,13 7,15 7,18 M 2,17 L 3,17" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" FontSize="9.5" FontWeight="Bold" Text="CAST" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MiniPlayerButton" Margin="0,0,8,0" Height="32" Padding="12,0" Style="{StaticResource SecondaryButton}" Click="ToggleMiniPlayer_Click" ToolTip="Compact always-on-top player (Ctrl+Shift+M)">
                        <TextBlock x:Name="MiniPlayerButtonText" VerticalAlignment="Center" FontSize="9.5" FontWeight="Bold" Text="MINI" />
                    </Button>
                    <Button x:Name="UpdateNavigationButton" Margin="0,0,10,0" Height="32" Padding="14,0" Style="{StaticResource SecondaryButton}" Click="OpenUpdate_Click" ToolTip="Check for a new StreamVue version">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,7,0" FontSize="14" Foreground="{StaticResource AccentBrush}" Text="↥" />
                            <TextBlock x:Name="UpdateNavigationText" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Text="UPDATE" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <TextBlock FontSize="16" Text="−" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Maximize_Click" ToolTip="Maximize">
                        <TextBlock FontSize="12" Text="□" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Close">
                        <TextBlock FontSize="15" Text="×" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspace -->
        <Grid x:Name="WorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="82" />
                <ColumnDefinition x:Name="CatalogColumn" Width="368" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="286" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="#0B0F17" BorderBrush="#1A2230" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,18,0,0" HorizontalAlignment="Center">
                        <RadioButton x:Name="WatchNavigation" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="True" Checked="WatchNavigation_Checked" ToolTip="All channels">
                            <TextBlock FontSize="22" Text="▶" />
                        </RadioButton>
                        <RadioButton x:Name="GuideNavigation" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="GuideNavigation_Checked" ToolTip="TV guide">
                            <TextBlock FontSize="21" Text="▦" />
                        </RadioButton>
                        <RadioButton x:Name="FavoritesNavigation" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="FavoritesNavigation_Checked" ToolTip="Favorites">
                            <TextBlock FontSize="22" Text="★" />
                        </RadioButton>
                        <RadioButton x:Name="MultiviewNavigation" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="MultiviewNavigation_Checked" ToolTip="Multiview — watch up to four channels">
                            <TextBlock FontSize="20" Text="⊞" />
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,18" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="52" Height="52" Click="OpenSettings_Click" ToolTip="Playback settings">
                            <TextBlock FontSize="22" Text="⚙" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Channel catalog -->
            <Border x:Name="CatalogPanel" Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="#1A2230" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="22,20,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CatalogHeading" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Channels" />
                            <TextBlock x:Name="SourceNameText" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="No source connected" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SourceRefreshText" Margin="0,3,0,0" FontSize="9.5" Foreground="#55CFC3" Text="Connect once for automatic refresh" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,6,0" Style="{StaticResource IconButton}" Width="42" Height="42" Click="OpenPlaylistHealth_Click" ToolTip="Playlist health center">
                                <TextBlock FontSize="17" Text="◉" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="42" Height="42" Background="{StaticResource AccentDimBrush}" Foreground="{StaticResource AccentBrush}" Click="OpenImport_Click" ToolTip="Add or change source">
                                <TextBlock FontSize="23" Text="＋" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20,0,20,12">
                        <TextBox x:Name="SearchBox" Height="42" Padding="39,10,12,10" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search channels or groups" />
                        <TextBlock Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#66758B" FontSize="17" IsHitTestVisible="False" Text="⌕" />
                        <TextBlock x:Name="SearchHint" Margin="39,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#5E6B7F" IsHitTestVisible="False" Text="Search channels or groups" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="20,0,20,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="AllFilter" GroupName="KindFilter" IsChecked="True" Checked="KindFilter_Checked" Tag="All" Content="All" Style="{StaticResource FilterPill}" />
                            <RadioButton GroupName="KindFilter" Checked="KindFilter_Checked" Tag="Live" Content="Live" Style="{StaticResource FilterPill}" />
                            <RadioButton GroupName="KindFilter" Checked="KindFilter_Checked" Tag="Movie" Content="Movies" Style="{StaticResource FilterPill}" />
                        </StackPanel>
                        <ComboBox x:Name="CategoryBox"
                                  Grid.Column="1"
                                  Width="164"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectionChanged="CategoryBox_SelectionChanged"
                                  AutomationProperties.Name="Channel group">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBoxItem Content="All groups" Tag="" />
                        </ComboBox>
                    </Grid>

                    <ListBox x:Name="ChannelList"
                             Grid.Row="3"
                             Margin="12,0,8,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="ChannelList_SelectionChanged"
                             PreviewMouseLeftButtonDown="ChannelList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ChannelList_PreviewMouseMove"
                             AutomationProperties.Name="Channels">
                        <ListBox.GroupStyle>
                            <GroupStyle HidesIfEmpty="True">
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,13,4,5" Padding="10,7" CornerRadius="8" Background="#111A26" BorderBrush="#26364A" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="3" Height="16" Margin="0,0,8,0" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                                                    <TextBlock Foreground="#DDE5F0" FontSize="10.5" FontWeight="Bold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Margin="8,0,0,0" Padding="6,2" CornerRadius="5" Background="#223044">
                                                    <TextBlock Foreground="#9CA9BC" FontSize="8.5" FontWeight="SemiBold" Text="{Binding ItemCount}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Card" Padding="10,9" CornerRadius="11" Background="Transparent" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="45" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="39" Height="39" HorizontalAlignment="Left">
                                            <Border CornerRadius="10" Background="#1B2432" BorderBrush="#2A3649" BorderThickness="1" />
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B8C5D8" FontSize="11" FontWeight="Bold" Text="{Binding Initials}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="7,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="{Binding Group}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="GuideLineText" Margin="0,4,0,0" Foreground="#62CFC4" FontSize="9" Text="{Binding GuideLine}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GuideLine}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Button x:Name="FavoriteButton" Width="28" Height="28" Margin="0,0,0,5" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#66758B" Cursor="Hand" Click="ToggleFavorite_Click" ToolTip="{Binding FavoriteLabel}">
                                                <TextBlock x:Name="FavoriteGlyph" FontSize="17" Text="{Binding FavoriteGlyph}" />
                                            </Button>
                                            <Border Padding="6,2" CornerRadius="4" Background="#152D2E">
                                                <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="8" FontWeight="Bold" Text="{Binding SignalFeedLabel}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="#171F2B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="#193239" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter TargetName="FavoriteButton" Property="Foreground" Value="#F4BD6B" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="FavoritesEmptyState" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="250" IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Center" FontSize="28" Foreground="#F4BD6B" Text="☆" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="No favorites yet" />
                        <TextBlock Margin="0,6,0,0" TextAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Text="Use the star beside a channel to build your quick-access list." TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="20,11,20,14">
                        <TextBlock x:Name="ChannelCountText" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Text="0 channels" />
                        <TextBlock HorizontalAlignment="Right" Foreground="#596579" FontSize="10" Text="VIRTUALIZED LIBRARY" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Player -->
            <Grid x:Name="PlayerPanel" Grid.Column="2" Margin="22,18,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PlayerHeaderRow" Height="Auto" />
                    <RowDefinition x:Name="PlayerVideoRow" Height="*" />
                    <RowDefinition x:Name="PlayerControlsRow" Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="2,0,2,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="NowPlayingHeading" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Ready when you are" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse x:Name="LiveDot" Width="6" Height="6" Margin="0,0,7,0" Fill="#526075" VerticalAlignment="Center" />
                            <TextBlock x:Name="NowPlayingSubheading" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Text="Choose a source to begin" />
                        </StackPanel>
                        <TextBlock x:Name="NowPlayingProgramText" Margin="0,6,0,0" Foreground="#D7E4F2" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        <TextBlock x:Name="NowPlayingNextText" Margin="0,3,0,0" Foreground="#718096" FontSize="9.5" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Margin="0,0,9,0" Padding="10,6" CornerRadius="8" Background="#121923" BorderBrush="#263144" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="LIBVLC NATIVE" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource IconButton}" Background="{StaticResource SurfaceRaisedBrush}" Click="ToggleFullscreen_Click" ToolTip="True fullscreen (F11 or Alt+Enter)">
                            <TextBlock FontSize="18" Text="⛶" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="PlayerVideoFrame" Grid.Row="1" CornerRadius="18" Background="#020305" BorderBrush="#263144" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="VideoSurface" Background="#020305">
                            <Grid x:Name="NativeVideoOverlay" Background="Transparent" MouseLeftButtonDown="VideoOverlay_MouseLeftButtonDown">
                                <Border x:Name="PlayerTopStatus" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Padding="10,6" CornerRadius="7" Background="#B20B1018" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#FF536A" Margin="0,0,7,0" />
                                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Text="LIVE" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="BufferOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,12" CornerRadius="12" Background="#D00A0E15" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <ProgressBar x:Name="BufferProgress" Width="70" Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock x:Name="BufferText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextBrush}" Text="Tuning…" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="RecoveryOverlay" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,17" Panel.ZIndex="3" CornerRadius="14" Background="#EC101722" BorderBrush="#625376" BorderThickness="1" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="RecoveryHeading" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" Foreground="#F0F4FA" Text="Restoring the signal" />
                                        <TextBlock x:Name="RecoveryDetail" Margin="0,7,0,0" Foreground="#A7B5C9" FontSize="10.5" LineHeight="16" TextWrapping="Wrap" />
                                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                            <Button Padding="13,7" Style="{StaticResource PrimaryButton}" Click="RetryPlayback_Click" Content="Retry now" />
                                            <Button Margin="8,0,0,0" Padding="13,7" Style="{StaticResource SecondaryButton}" Click="StabilizePlayback_Click" Content="Use stable buffer" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="FullscreenHud" Margin="28" Padding="18,15" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Panel.ZIndex="4" CornerRadius="16" Background="#E90A1018" BorderBrush="#394A62" BorderThickness="1" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="54" Height="54" CornerRadius="13" Background="#17302F" BorderBrush="#31514F" BorderThickness="1">
                                            <TextBlock x:Name="HudChannelInitials" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" Text="TV" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,24,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="HudChannelNumber" Margin="0,0,9,0" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                                <TextBlock x:Name="HudChannelName" Foreground="#F4F7FB" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="HudGroupName" Margin="10,3,0,0" Foreground="#7F90A8" FontSize="9.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock x:Name="HudNowTitle" Margin="0,5,0,0" Foreground="#D9E3EF" FontSize="11" FontWeight="SemiBold" Text="Live television" TextTrimming="CharacterEllipsis" />
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <ProgressBar x:Name="HudProgramProgress" Height="3" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="#263246" />
                                                <TextBlock x:Name="HudProgramTime" Grid.Column="1" Margin="12,-5,0,0" Foreground="#8494AA" FontSize="9" />
                                            </Grid>
                                            <TextBlock x:Name="HudNextTitle" Margin="0,6,0,0" Foreground="#8494AA" FontSize="9.5" Text="NEXT  Guide unavailable" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="HudClock" HorizontalAlignment="Right" Foreground="#EFF4FA" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock x:Name="HudTechnical" Margin="0,5,0,0" HorizontalAlignment="Right" Foreground="#7E8EA6" FontSize="9" />
                                            <StackPanel Margin="0,8,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button Padding="10,6" Style="{StaticResource SecondaryButton}" Click="PreviousChannel_Click" Content="↶ Last" ToolTip="Return to the previous channel (Backspace)" />
                                                <Button Margin="6,0,0,0" Padding="10,6" Style="{StaticResource SecondaryButton}" Click="OpenQuickTune_Click" Content="Quick Tune" ToolTip="Find a channel without leaving fullscreen (Q)" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="QuickTuneOverlay" Width="560" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,46,0,0" Padding="18" Panel.ZIndex="8" CornerRadius="18" Background="#F40C121C" BorderBrush="#40516A" BorderThickness="1" Visibility="Collapsed">
