<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>OrbitalVue</AssemblyName>
    <RootNamespace>OrbitalVue.Player</RootNamespace>
    <Version>5.8.0-alpha.1</Version>
    <FileVersion>5.8.0.1</FileVersion>
    <AssemblyVersion>5.8.0.0</AssemblyVersion>
    <AssemblyTitle>OrbitalVue</AssemblyTitle>
    <Title>OrbitalVue</Title>
    <Product>OrbitalVue</Product>
    <Company>Chris</Company>
    <Description>OrbitalVue — a premium native IPTV and personal-media player for Windows.</Description>
    <ApplicationIcon>Assets\orbitalvue.ico</ApplicationIcon>
    <StartupObject>OrbitalVue.Player.Program</StartupObject>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <OrbitalVueDistributionMode Condition="'$(OrbitalVueDistributionMode)' == ''">Personal</OrbitalVueDistributionMode>
    <OrbitalVuePremiumProductId Condition="'$(OrbitalVuePremiumProductId)' == ''"></OrbitalVuePremiumProductId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OrbitalVueDistributionMode)' == 'Store'">
    <DefineConstants>$(DefineConstants);ORBITALVUE_STORE_BUILD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(QaBuild)' == 'true'">
    <AssemblyName>OrbitalVueQa</AssemblyName>
    <DefineConstants>$(DefineConstants);ORBITALVUE_QA_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.0" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.0" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="Velopack" Version="1.2.0" Condition="'$(OrbitalVueDistributionMode)' != 'Store'" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\orbitalvue.ico" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OrbitalVuePremiumProductId</_Parameter1>
      <_Parameter2>$(OrbitalVuePremiumProductId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="ValidateOrbitalVueDistributionMode" BeforeTargets="CoreCompile">
    <Error
      Condition="'$(OrbitalVueDistributionMode)' != 'Personal' and '$(OrbitalVueDistributionMode)' != 'Store'"
      Text="OrbitalVueDistributionMode must be Personal or Store. Unknown release modes fail closed." />
    <Error
      Condition="'$(OrbitalVuePremiumProductId)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(OrbitalVuePremiumProductId)', '^[A-Za-z0-9._-]{3,256}$'))"
      Text="OrbitalVuePremiumProductId must be empty or an exact Partner Center product identifier." />
  </Target>

</Project>
