{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "streamvue-entitlement-verifier",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": [
      "GOOGLE_SERVICE_ACCOUNT_EMAIL",
      "GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY",
      "SAMSUNG_DPI_SECURITY_KEY",
      "RATE_LIMIT_KEY_SECRET"
    ]
  },
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "local",
    "EXPECTED_HOSTNAME": "entitlements.example.invalid",
    "ALLOWED_BROWSER_ORIGINS": "[]",
    "GOOGLE_PLAY_PACKAGE_NAME": "com.streamvue.player",
    "GOOGLE_PLAY_PRODUCT_ID": "REPLACE_IN_PLAY_CONSOLE",
    "GOOGLE_PLAY_ALLOW_TEST_PURCHASES": "false",
    "SAMSUNG_CHECKOUT_APP_ID": "REPLACE_IN_SELLER_OFFICE",
    "SAMSUNG_PREMIUM_PRODUCT_ID": "REPLACE_PRODUCT"
  },
  "ratelimits": [
    {
      "name": "VERIFICATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "PROVIDER_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "env": {
    "staging": {
      "name": "streamvue-entitlement-verifier-staging",
      "workers_dev": false,
      "preview_urls": false,
      "secrets": {
        "required": [
          "GOOGLE_SERVICE_ACCOUNT_EMAIL",
          "GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY",
          "SAMSUNG_DPI_SECURITY_KEY",
          "RATE_LIMIT_KEY_SECRET"
        ]
      },
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "staging",
        "EXPECTED_HOSTNAME": "staging-entitlements.example.invalid",
        "ALLOWED_BROWSER_ORIGINS": "[]",
        "GOOGLE_PLAY_PACKAGE_NAME": "com.streamvue.player",
        "GOOGLE_PLAY_PRODUCT_ID": "REPLACE_IN_PLAY_CONSOLE",
        "GOOGLE_PLAY_ALLOW_TEST_PURCHASES": "false",
        "SAMSUNG_CHECKOUT_APP_ID": "REPLACE_IN_SELLER_OFFICE",
        "SAMSUNG_PREMIUM_PRODUCT_ID": "REPLACE_PRODUCT"
      },
      "ratelimits": [
        {
          "name": "VERIFICATION_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "PROVIDER_RATE_LIMITER",
          "namespace_id": "1005",
          "simple": { "limit": 600, "period": 60 }
        }
      ]
    },
    "production": {
      "name": "streamvue-entitlement-verifier-production",
      "workers_dev": false,
      "preview_urls": false,
      "secrets": {
        "required": [
          "GOOGLE_SERVICE_ACCOUNT_EMAIL",
          "GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY",
          "SAMSUNG_DPI_SECURITY_KEY",
          "RATE_LIMIT_KEY_SECRET"
        ]
      },
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "production",
        "EXPECTED_HOSTNAME": "entitlements.example.invalid",
        "ALLOWED_BROWSER_ORIGINS": "[]",
        "GOOGLE_PLAY_PACKAGE_NAME": "com.streamvue.player",
        "GOOGLE_PLAY_PRODUCT_ID": "REPLACE_IN_PLAY_CONSOLE",
        "GOOGLE_PLAY_ALLOW_TEST_PURCHASES": "false",
        "SAMSUNG_CHECKOUT_APP_ID": "REPLACE_IN_SELLER_OFFICE",
        "SAMSUNG_PREMIUM_PRODUCT_ID": "REPLACE_PRODUCT"
      },
      "ratelimits": [
        {
          "name": "VERIFICATION_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "PROVIDER_RATE_LIMITER",
          "namespace_id": "1006",
          "simple": { "limit": 600, "period": 60 }
        }
      ]
    }
  }
}
